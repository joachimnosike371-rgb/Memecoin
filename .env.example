# Supabase server-side durable audit storage (never expose service role key to browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AUDIT_WRITE_SECRET=

# X API v2 recent-search bearer token (server only)
X_BEARER_TOKEN=

# xAI / Grok API key and optional model override (server only)
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Scheduler secret; set a high-entropy secret in the deployment environment
CRON_SECRET=

# Chain RPC endpoints; use testnet endpoints during development
ETHEREUM_RPC_URL=
BNB_RPC_URL=
SOLANA_RPC_URL=
